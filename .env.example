# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Google Gemini (só no servidor, nunca exposto ao cliente). Chave do AI Studio.
GEMINI_API_KEY=
# Modelo do chat. Precisa suportar function calling e imagem.
GEMINI_MODEL=gemini-3.5-flash
# Modelo reserva quando o principal está indisponível (503)
GEMINI_MODEL_FALLBACK=gemini-3.8-flash

# URL pública do site (usada no link mágico). Na Vercel pode deixar vazio: usa VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Limite de mensagens de chat por usuário por hora
CHAT_RATE_LIMIT_PER_HOUR=120
